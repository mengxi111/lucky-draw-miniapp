page {
  background: #f2f2f2;
}

.create-page {
  min-height: 100vh;
  padding: 18rpx 20rpx calc(154rpx + env(safe-area-inset-bottom));
  color: #171717;
}

.create-summary {
  padding: 24rpx;
  border: 2rpx solid #e3e3df;
  border-radius: 8rpx;
  background: #fff;
}

.summary-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.summary-actions {
  display: flex;
  flex: none;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.summary-title {
  font-size: 28rpx;
  font-weight: 750;
}

.summary-copy {
  margin-top: 7rpx;
  color: #858681;
  font-size: 22rpx;
  line-height: 1.45;
}

.summary-status {
  flex: none;
  padding: 8rpx 14rpx;
  border-radius: 6rpx;
  background: #f0f0ec;
  color: #777873;
  font-size: 20rpx;
  font-weight: 700;
}

.summary-status.is-ready {
  background: #e8f6ed;
  color: #267743;
}

.draft-note {
  margin-top: 7rpx;
  color: #08a962;
  font-size: 20rpx;
  line-height: 1.4;
}

.draft-clear {
  min-width: 0;
  height: 38rpx;
  padding: 0 8rpx;
  border: 0;
  background: transparent;
  color: #a06b2e;
  font-size: 19rpx;
  line-height: 38rpx;
}

.progress-track {
  height: 8rpx;
  overflow: hidden;
  margin-top: 20rpx;
  border-radius: 4rpx;
  background: #ecece8;
}

.progress-value {
  height: 100%;
  border-radius: 4rpx;
  background: #e4473b;
  transition: width 180ms ease;
}

.template-scroll,
.prize-type-scroll {
  width: 100%;
  white-space: nowrap;
}

.template-list {
  display: inline-flex;
  gap: 14rpx;
  padding: 4rpx 2rpx 18rpx;
}

.template-card {
  display: inline-flex;
  width: 176rpx;
  height: 108rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx solid transparent;
  border-radius: 8rpx;
  background: #fff;
  box-shadow: 0 7rpx 18rpx rgba(0, 0, 0, 0.06);
  color: #232323;
  font-size: 24rpx;
}

.template-card.is-active {
  border-color: #e4473b;
  box-shadow: 0 7rpx 18rpx rgba(228, 71, 59, 0.12);
}

.template-mark {
  display: flex;
  width: 44rpx;
  height: 44rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
  border: 3rpx solid #414141;
  border-radius: 50%;
  color: #ea493d;
  font-size: 20rpx;
  font-weight: 800;
}

.section-kicker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 12rpx 12rpx;
  color: #878787;
  font-size: 24rpx;
}

.scene-kicker {
  padding-top: 24rpx;
}

.muted-note {
  font-size: 21rpx;
}

.help-link,
.feature-link {
  color: #08b76d;
}

.form-card {
  overflow: hidden;
  border-radius: 8rpx;
  background: #fff;
}

.prize-card {
  padding: 22rpx 20rpx 0;
}

.gift-visual {
  position: relative;
  overflow: hidden;
  height: 372rpx;
  background: #f16051;
}

.gift-cover-image,
.gift-cover-shade {
  position: absolute;
  z-index: 0;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.gift-cover-shade {
  background: rgba(37, 27, 23, 0.08);
}

.gift-visual.tone-gold {
  background: #eba84f;
}

.gift-visual.tone-green {
  background: #43a783;
}

.change-cover {
  position: absolute;
  z-index: 4;
  top: 18rpx;
  right: 18rpx;
  min-width: 154rpx;
  height: 56rpx;
  padding: 0 16rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.75);
  border-radius: 7rpx;
  background: rgba(176, 53, 43, 0.38);
  color: #fff;
  font-size: 23rpx;
  line-height: 52rpx;
}

.gift-floor {
  position: absolute;
  right: -40rpx;
  bottom: -86rpx;
  left: -40rpx;
  height: 260rpx;
  border-radius: 50% 50% 0 0;
  background: rgba(154, 45, 37, 0.38);
}

.gift-scene {
  position: absolute;
  z-index: 3;
  right: 0;
  bottom: 102rpx;
  left: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 58rpx;
}

.gift-box {
  position: relative;
  border-radius: 4rpx;
  background: #ffe0a6;
  box-shadow: 10rpx 15rpx 0 rgba(117, 39, 32, 0.1);
}

.gift-main {
  width: 270rpx;
  height: 212rpx;
}

.gift-small {
  width: 122rpx;
  height: 140rpx;
}

.gift-lid {
  position: absolute;
  top: -18rpx;
  right: -8rpx;
  left: -8rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: #ffe7b8;
}

.gift-ribbon-v {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 122rpx;
  width: 26rpx;
  background: #ef594a;
}

.gift-ribbon-h {
  position: absolute;
  top: 72rpx;
  right: 0;
  left: 0;
  height: 24rpx;
  background: #ef594a;
}

.gift-bow {
  position: absolute;
  z-index: 2;
  top: 30rpx;
  left: 78rpx;
  color: #ef594a;
  font-family: Georgia, serif;
  font-size: 112rpx;
  font-weight: 700;
  line-height: 1;
  transform: rotate(-6deg);
}

.open-seal {
  position: absolute;
  top: 28rpx;
  left: 34rpx;
  display: flex;
  width: 56rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  border: 5rpx solid #fff7e8;
  border-radius: 50%;
  background: #ef594a;
  color: #fff;
  font-size: 27rpx;
  font-weight: 800;
}

.prize-type-list {
  display: inline-flex;
  min-width: 100%;
  gap: 10rpx;
  padding: 20rpx 0 12rpx;
}

.prize-type {
  display: inline-flex;
  min-width: 122rpx;
  height: 68rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  justify-content: center;
  padding: 0 18rpx;
  border: 2rpx solid #dedede;
  border-radius: 6rpx;
  color: #444;
  font-size: 22rpx;
}

.prize-type-list .prize-type {
  flex: 1;
}

.cloud-prize-note {
  padding: 2rpx 0 12rpx;
  color: #999a95;
  font-size: 20rpx;
  line-height: 1.45;
}

.prize-type.is-disabled {
  border-color: #e1e1dd;
  background: #f5f5f2;
  color: #aaa;
}

.prize-type-note {
  margin-top: 4rpx;
  font-size: 16rpx;
}

.prize-type.is-active,
.draw-tab.is-active {
  border-color: #08bf72;
  background: #f2fff9;
  color: #08a962;
  font-weight: 700;
}

.line-field,
.schedule-row,
.switch-row,
.limit-row,
.organizer-row {
  display: flex;
  min-height: 86rpx;
  align-items: center;
  border-bottom: 2rpx solid #efefef;
}

.line-field.compact {
  margin-top: 10rpx;
}

.line-label {
  flex: none;
  color: #171717;
  font-size: 25rpx;
  font-weight: 600;
}

.line-input {
  height: 84rpx;
  min-width: 0;
  flex: 1;
  padding-left: 36rpx;
  color: #222;
  font-size: 25rpx;
  text-align: right;
}

.input-placeholder {
  color: #b5b5b5;
}

.field-error {
  padding: 8rpx 0 12rpx;
  color: #e84035;
  font-size: 21rpx;
}

.setting-card {
  padding: 20rpx;
}

.draw-mode-summary {
  display: flex;
  min-height: 104rpx;
  align-items: center;
  border-bottom: 2rpx solid #efefef;
}

.draw-mode-copy {
  min-width: 0;
  flex: 1;
}

.mode-ready {
  flex: none;
  padding: 7rpx 13rpx;
  border-radius: 6rpx;
  background: #e8f6ed;
  color: #247541;
  font-size: 19rpx;
  font-weight: 700;
}

.draw-tabs {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}

.draw-tab {
  display: flex;
  height: 72rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #dedede;
  border-radius: 6rpx;
  color: #555;
  font-size: 23rpx;
}

.draw-tab.is-disabled {
  border-color: #e7e7e7;
  background: #f7f7f7;
  color: #9b9b9b;
}

.draw-tab-note {
  margin-top: 3rpx;
  color: #b0b0b0;
  font-size: 16rpx;
  line-height: 1;
}

.schedule-pickers {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
  justify-content: flex-end;
  gap: 18rpx;
}

.picker-value {
  color: #8a8a8a;
  font-size: 23rpx;
}

.schedule-error {
  padding-left: 0;
}

.instant-note {
  display: flex;
  min-height: 112rpx;
  align-items: center;
  border-bottom: 2rpx solid #efefef;
}

.instant-mark {
  display: flex;
  width: 60rpx;
  height: 60rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  border-radius: 50%;
  background: #f16051;
  color: #fff;
  font-weight: 800;
}

.instant-title {
  font-size: 24rpx;
  font-weight: 600;
}

.instant-copy {
  margin-top: 7rpx;
  color: #999;
  font-size: 20rpx;
}

.switch-row,
.limit-row {
  justify-content: space-between;
  color: #242424;
  font-size: 24rpx;
}

.setting-label-line {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 12rpx;
}

.setting-unavailable {
  flex: none;
  color: #aaa;
  font-size: 19rpx;
}

.switch-row switch,
.feature-row switch {
  transform: scale(0.78);
  transform-origin: right center;
}

.limit-row {
  border-bottom: 0;
}

.limit-control {
  display: flex;
  gap: 7rpx;
}

.limit-option {
  display: flex;
  width: 50rpx;
  height: 48rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #ddd;
  border-radius: 6rpx;
  color: #777;
  font-size: 21rpx;
}

.limit-option.is-active {
  border-color: #08bf72;
  background: #08bf72;
  color: #fff;
}

.intro-card {
  padding: 10rpx 20rpx 22rpx;
}

.organizer-row {
  justify-content: space-between;
}

.contact-entry {
  display: flex;
  align-items: center;
  color: #666;
  font-size: 23rpx;
}

.chevron {
  margin-left: 12rpx;
  color: #aaa;
  font-size: 36rpx;
}

.profile-strip {
  display: flex;
  height: 116rpx;
  align-items: center;
  margin: 0 0 20rpx;
  padding: 0 24rpx;
  border: 2rpx solid transparent;
  border-radius: 8rpx;
  background: #f6f6f6;
}

.profile-strip.has-error {
  border-color: #ef4338;
}

.avatar {
  display: flex;
  width: 74rpx;
  height: 74rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  border-radius: 50%;
  background: #232b2a;
  color: #fff;
  font-size: 27rpx;
  font-weight: 700;
}

.organizer-input {
  height: 90rpx;
  min-width: 0;
  flex: 1;
  font-size: 25rpx;
  font-weight: 600;
}

.description-label {
  margin-bottom: 14rpx;
  font-size: 25rpx;
  font-weight: 600;
}

.description-area,
.intro-block-input {
  display: block;
  width: 100%;
  height: 168rpx;
  padding: 18rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 8rpx;
  color: #222;
  font-size: 24rpx;
  line-height: 1.55;
}

.intro-block-card {
  margin-top: 18rpx;
  padding: 0 20rpx;
}

.intro-block {
  padding: 22rpx 0;
  border-bottom: 2rpx solid #eee;
}

.intro-block-heading {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
  font-size: 23rpx;
  font-weight: 600;
}

.remove-link {
  color: #e84035;
  font-weight: 400;
}

.intro-block-input {
  height: 130rpx;
}

.add-intro {
  display: flex;
  min-height: 126rpx;
  align-items: center;
  justify-content: center;
  color: #777;
  font-size: 23rpx;
  background: transparent;
}

.more-trigger {
  display: flex;
  height: 84rpx;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 18rpx;
  color: #08b76d;
  font-size: 23rpx;
  font-weight: 600;
}

.feature-section {
  margin-top: 22rpx;
}

.cloud-capability-panel {
  margin-top: 18rpx;
  padding: 24rpx 22rpx;
  border-left: 6rpx solid #b8873d;
  border-radius: 8rpx;
  background: #fff9ed;
}

.cloud-capability-title {
  color: #4c4131;
  font-size: 25rpx;
  font-weight: 700;
}

.cloud-capability-copy {
  margin-top: 8rpx;
  color: #88775f;
  font-size: 21rpx;
  line-height: 1.55;
}

.cloud-capability-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.cloud-capability-item {
  padding: 8rpx 12rpx;
  border: 2rpx solid #eadabd;
  border-radius: 6rpx;
  background: #fff;
  color: #7c684a;
  font-size: 19rpx;
}

.feature-heading {
  padding: 0 10rpx 12rpx;
  color: #8d8d8d;
  font-size: 23rpx;
}

.feature-list {
  overflow: hidden;
  border-radius: 8rpx;
}

.feature-row {
  display: flex;
  min-height: 84rpx;
  align-items: center;
  padding: 0 20rpx;
  border-bottom: 2rpx solid #eee;
  background: #fff;
}

.feature-row:last-child {
  border-bottom: 0;
}

.feature-copy {
  min-width: 0;
  flex: 1;
  padding: 15rpx 10rpx 15rpx 0;
}

.feature-title-line {
  font-size: 24rpx;
}

.feature-link {
  margin-left: 14rpx;
  color: #8a8a8a;
  font-size: 21rpx;
  text-decoration: underline;
}

.feature-subtitle {
  margin-top: 7rpx;
  color: #888;
  font-size: 20rpx;
  line-height: 1.4;
}

.advanced-row {
  min-height: 122rpx;
}

.advanced-badge {
  display: flex;
  width: 66rpx;
  height: 66rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
  border-radius: 8rpx;
  background: #fff2d3;
  color: #a77326;
  font-size: 26rpx;
}

.policy-note {
  padding: 26rpx 12rpx 10rpx;
  color: #999;
  font-size: 20rpx;
  text-align: center;
}

.bottom-actions {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  display: grid;
  grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
  gap: 16rpx;
  padding: 14rpx 18rpx calc(14rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid #e3e3e3;
  background: rgba(255, 255, 255, 0.98);
}

.preview-mask {
  position: fixed;
  z-index: 60;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.46);
}

.preview-sheet {
  width: 100%;
  max-height: calc(100vh - 80rpx);
  overflow-y: auto;
  padding: 14rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 12rpx 12rpx 0 0;
  background: #f5f5f2;
}

.preview-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 0 18rpx;
}

.preview-kicker {
  color: #9a6a27;
  font-size: 19rpx;
  font-weight: 700;
}

.preview-title {
  margin-top: 4rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.preview-close {
  display: flex;
  width: 62rpx;
  height: 62rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #e8e8e4;
  color: #6e6f6a;
  font-size: 38rpx;
}

.preview-cover {
  position: relative;
  height: 300rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: #d95649;
  color: #fff;
}

.preview-cover.tone-gold { background: #b67a25; }
.preview-cover.tone-green { background: #47745a; }

.preview-cover-image,
.preview-cover-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.preview-cover-shade { background: rgba(21, 22, 20, 0.36); }

.preview-category {
  position: absolute;
  z-index: 1;
  top: 18rpx;
  left: 18rpx;
  padding: 7rpx 13rpx;
  border-radius: 6rpx;
  background: rgba(29, 29, 27, 0.62);
  font-size: 19rpx;
}

.preview-cover-copy {
  position: absolute;
  z-index: 1;
  right: 22rpx;
  bottom: 22rpx;
  left: 22rpx;
}

.preview-activity-title {
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.25;
}

.preview-activity-copy {
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.45;
}

.preview-details {
  margin-top: 16rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: #fff;
}

.preview-row {
  display: flex;
  min-height: 74rpx;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 0 20rpx;
  border-bottom: 2rpx solid #efefeb;
  color: #7d7e79;
  font-size: 22rpx;
}

.preview-row:last-child { border-bottom: 0; }
.preview-row text:last-child { color: #30312e; text-align: right; overflow-wrap: break-word; }

.preview-note {
  padding: 16rpx 0;
  color: #92938e;
  font-size: 20rpx;
  text-align: center;
}

.preview-actions {
  display: grid;
  grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
  gap: 14rpx;
}

.preview-edit,
.preview-publish {
  height: 82rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: 750;
  line-height: 82rpx;
}

.preview-edit {
  border: 2rpx solid #d8d8d3;
  background: #fff;
  color: #555651;
}

.preview-publish {
  background: #e4473b;
  color: #fff;
}

.test-button,
.submit-button,
.sheet-clear,
.sheet-confirm {
  height: 78rpx;
  border-radius: 8rpx;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 78rpx;
}

.test-button {
  border: 2rpx solid #ef4338;
  background: #fff;
  color: #ef4338;
}

.submit-button,
.sheet-confirm {
  background: #ed4438;
  color: #fff;
}

.sheet-mask {
  position: fixed;
  z-index: 50;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.43);
}

.contact-sheet {
  width: 100%;
  max-height: calc(100vh - 80rpx);
  overflow-y: auto;
  padding: 14rpx 20rpx calc(20rpx + env(safe-area-inset-bottom));
  border-radius: 12rpx 12rpx 0 0;
  background: #f5f5f5;
}

.sheet-handle {
  width: 70rpx;
  height: 7rpx;
  margin: 0 auto 14rpx;
  border-radius: 6rpx;
  background: #d7d7d7;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
}

.sheet-copy {
  padding: 12rpx 0 14rpx;
  color: #8b8b8b;
  font-size: 22rpx;
}

.contact-option-list {
  overflow: hidden;
  border-radius: 8rpx;
  background: #fff;
}

.contact-option {
  display: flex;
  min-height: 86rpx;
  align-items: center;
  padding: 12rpx 16rpx;
  border-bottom: 2rpx solid #eee;
}

.contact-option.is-disabled {
  color: #aaa;
}

.contact-option-copy {
  min-width: 0;
  flex: 1;
}

.contact-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.contact-unavailable {
  color: #aaa;
  font-size: 18rpx;
}

.contact-option:last-child {
  border-bottom: 0;
}

.radio {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  flex: none;
  margin-right: 18rpx;
  border: 2rpx solid #ccc;
  border-radius: 50%;
}

.radio.is-active {
  border: 9rpx solid #08bf72;
}

.contact-title {
  font-size: 24rpx;
}

.contact-subtitle {
  margin-top: 5rpx;
  color: #969696;
  font-size: 19rpx;
}

.sheet-note-label {
  padding: 18rpx 2rpx 10rpx;
  color: #777;
  font-size: 22rpx;
}

.sheet-note-label text {
  color: #aaa;
  font-size: 19rpx;
}

.contact-input {
  height: 76rpx;
  padding: 0 18rpx;
  border-radius: 7rpx;
  background: #fff;
  font-size: 24rpx;
}

.contact-input[disabled] {
  background: #f1f1ee;
  color: #aaa;
}

.contact-error {
  padding: 10rpx 2rpx 0;
}

.sheet-buttons {
  display: grid;
  grid-template-columns: minmax(0, 0.65fr) minmax(0, 1.35fr);
  gap: 14rpx;
  padding-top: 18rpx;
}

.sheet-clear {
  border: 2rpx solid #ddd;
  background: #fff;
  color: #666;
}
