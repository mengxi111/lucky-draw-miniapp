page {
  min-height: 100%;
  background: #f2f2f2;
  color: #242522;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
  letter-spacing: 0;
}

view,
text,
button,
input,
textarea,
image,
picker {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border-radius: 8rpx;
  font-size: 28rpx;
  line-height: 1;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
}

.switch-control {
  position: relative;
  width: 96rpx;
  height: 56rpx;
  flex: 0 0 96rpx;
  border: 2rpx solid #dedede;
  border-radius: 30rpx;
  background: #f4f4f4;
  transition: background 160ms ease, border-color 160ms ease;
}

.switch-control::after {
  position: absolute;
  top: 3rpx;
  left: 3rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 3rpx 9rpx rgba(0, 0, 0, 0.18);
  content: "";
  transition: transform 160ms ease;
}

.switch-control.is-on {
  border-color: #12bd68;
  background: #12bd68;
}

.switch-control.is-on::after {
  transform: translateX(40rpx);
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.25;
}

.section-note {
  margin-top: 8rpx;
  color: #797a77;
  font-size: 24rpx;
  line-height: 1.5;
}

.primary-button,
.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
  padding: 0 32rpx;
  border-radius: 8rpx;
  font-weight: 700;
}

.primary-button {
  background: #d94a3a;
  color: #fff;
}

.primary-button[disabled] {
  background: #d7d4cf;
  color: #fff;
}

.secondary-button {
  border: 2rpx solid #d9dad5;
  background: #fff;
  color: #333431;
}

.empty-state {
  display: flex;
  min-height: 480rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.empty-symbol {
  display: flex;
  width: 112rpx;
  height: 112rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  border: 2rpx solid #deded8;
  border-radius: 50%;
  background: #fff;
  color: #d94a3a;
  font-size: 48rpx;
  font-weight: 800;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
}

.empty-copy {
  max-width: 520rpx;
  margin-top: 12rpx;
  color: #858681;
  font-size: 24rpx;
  line-height: 1.6;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 16rpx;
  border-radius: 8rpx;
  background: #e9f5eb;
  color: #337a43;
  font-size: 21rpx;
  font-weight: 700;
}

.status-pill.muted {
  background: #efefeb;
  color: #777873;
}

.status-pill.warn {
  background: #fff0d7;
  color: #986018;
}

.divider {
  height: 2rpx;
  background: #ecece7;
}
